# 部署者无需改 Dockerfile，改这里即可。
# 复制为 .env 后按需修改：cp .env.example .env
#
# 注意：变量前缀为 APP_*。如果你从旧版本升级（此前用 V2RAY_* 前缀），
# 需要按本文件把 .env 重命名一遍，否则新值不会被读取。

# ---------------------------------------------------------------- 构建 ----
# 上游官方镜像的 tag（同时作为二进制版本）。4.x/5.x 的 CLI 不同，脚本自动探测。
SRC_VERSION=v5.41.0

# 运行时二进制名。改它就改了容器内的文件名与进程名，是去特征化的主要手段。
APP_BIN_NAME=relay

# 镜像名与容器名，都会出现在 docker ps / docker inspect 里，故使用中性名。
APP_IMAGE=relay
APP_CONTAINER_NAME=relay
EDGE_CONTAINER_NAME=front

# 构建期对二进制内的品牌字符串做等长替换（见 README「去特征化说明」）。
# 排查构建问题时才设为 false，它会保留二进制里的上游品牌字样。
DEBRAND=true

# ---------------------------------------------------------------- 边缘 ----
# 对外域名（resolve 到本机）。必填，用于自动申请 Let's Encrypt 证书，也用于生成分享链接。
# 留空时会退化为只在 80 端口提供服务（无证书），仅建议本机验证时使用。
APP_DOMAIN=

# Let's Encrypt 通知邮箱。当前 Caddyfile 未使用（空值会让 email 指令缺参数而解析失败），
# 仅作记录；需要时按 caddy/Caddyfile 顶部注释解开 email 指令。
ACME_EMAIL=

# ---------------------------------------------------------------- 服务 ----
# 容器内明文 WebSocket 监听端口。TLS 由 edge 终止，该端口不映射到公网。
APP_PORT=10000

# WebSocket 路径。建议换成不易猜测的长随机值，降低被主动探测识别的概率。
APP_WS_PATH=/vless-ws

# 服务端 UUID（客户端从此派生，必须一致）。
# 留空则首次启动自动生成并写入挂载的 ./data/uuid，重启后保持不变。
# 自行生成：python -c "import uuid;print(uuid.uuid4)"
APP_UUID=

# 可选：限定 WebSocket 的 Host 头。留空表示不校验；设为 APP_DOMAIN 可收紧。
APP_WS_HOST=

# 客户端标识，仅用于日志区分。
APP_EMAIL=app

# ---------------------------------------------------------------- 链接 ----
# 分享链接里的域名。留空则取 APP_DOMAIN；两者都空时用占位符 your.domain.com。
APP_SHARE_HOST=
# 分享链接里的端口。TLS 由 edge 终止，填 443。
APP_SHARE_PORT=443

# ---------------------------------------------------------------- 日志 ----
# debug / info / warning / error / none
APP_LOG_LEVEL=warning
# 留空则访问日志输出到 stdout、错误日志输出到 stderr（便于 docker logs 查看）。
APP_LOG_ACCESS=
APP_LOG_ERROR=

# ------------------------------------------------------------ 出站策略 ----
# 是否开启流量嗅探（用于按域名分流）。
APP_SNIFFING=true
# 出站域名解析策略：AsIs / UseIP / UseIPv4 / UseIPv6
APP_DOMAIN_STRATEGY=UseIP
# 是否丢弃目标是私网地址的出站流量（防止服务端被当作访问内网的跳板）。
APP_BLOCK_PRIVATE=true
# 主版本探测；仅在自动识别异常时才需强制 v4/v5。
APP_CLI=auto
